{
  "name": "bigquerysqlformatter",
  "displayName": "BigQuery SQL Formatter",
  "description": "VS Code extension providing BigQuery SQL syntax checking",
  "icon": "images/BigQuerySQLFormatter_transparent_128.png",
  "author": "sean-conkie",
  "license": "MIT",
  "version": "0.4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sean-conkie/BigQuerySQLFormatter-extension.git"
  },
  "publisher": "sean-conkie",
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "multi-root ready",
    "language server",
    "bigquery",
    "sql"
  ],
  "engines": {
    "vscode": "^1.91.0"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "BigQuerySQLFormatter",
      "properties": {
        "bigquerySQLFormatter.maxNumberOfProblems": {
          "scope": "resource",
          "type": "integer",
          "minimum": 0,
          "default": 100,
          "description": "Controls the maximum number of problems produced by the server."
        },
        "bigquerySQLFormatter.rules": {
          "scope": "resource",
          "type": "object",
          "default": {},
          "description": "Per-rule configuration. Set enabled, severity, and supported options; exclude lists disabled codes, and groups toggles rule families. The nearest .bqsqlformatter.json overrides individual fields.",
          "properties": {
            "CP04": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "severity": {
                  "type": "string",
                  "enum": ["error", "warning", "information", "hint", "off"],
                  "default": "warning"
                },
                "options": {
                  "type": "object",
                  "properties": {
                    "capitalisation_policy": {
                      "type": "string",
                      "enum": ["lower", "upper", "consistent"],
                      "default": "lower",
                      "description": "Literal casing. Consistent follows the first matching literal; a mixed-case first literal selects lowercase."
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(AL|AM|CP|CV|LT|ST)[0-9]{2}$"
              },
              "description": "Rule codes to disable."
            },
            "groups": {
              "type": "object",
              "properties": {
                "aliasing": {
                  "type": "boolean"
                },
                "ambiguous": {
                  "type": "boolean"
                },
                "capitalisation": {
                  "type": "boolean"
                },
                "convention": {
                  "type": "boolean"
                },
                "layout": {
                  "type": "boolean"
                },
                "structure": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "patternProperties": {
            "^(?!CP04$)(AL|AM|CP|CV|LT|ST)[0-9]{2}$": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "error",
                    "warning",
                    "information",
                    "hint",
                    "off"
                  ],
                  "default": "warning"
                },
                "options": {
                  "type": "object",
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "bigquerySQLFormatter.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server."
        }
      }
    },
    "languages": [
      {
        "id": "googlesql",
        "aliases": [
          "googlesql",
          "GoogleSQL"
        ],
        "extensions": [
          ".bqsql",
          ".bqddl",
          ".bqdml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "googlesql",
        "scopeName": "source.googlesql",
        "path": "./dist/syntaxes/googlesql.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[googlesql]": {
        "editor.defaultFormatter": "sean-conkie.bigquerysqlformatter",
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b && node scripts/build.cjs",
    "generate:completions": "node scripts/generate-completions.cjs",
    "watch": "node scripts/build.cjs --watch",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "package:check": "node scripts/check-package.cjs",
    "postinstall": "npm ci --prefix client && npm ci --prefix server",
    "test": "node --test scripts/generate-completions.test.cjs && mocha \"server/out/tests/**/*.test.js\"",
    "coverage": "nyc --check-coverage --branches 80 --reporter=lcov --reporter=text-summary npm test",
    "citest": "npm test && node ./client/out/test/runTest",
    "deploy": "vsce publish --no-yarn"
  },
  "overrides": {
    "@azure/identity@4.14.0": {
      "@azure/msal-node": "^7.1.1"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/chai": "^4.3.12",
    "@types/mocha": "^10.0.9",
    "@types/node": "^22.20.5",
    "@types/sinon": "^22.0.1",
    "@types/sinon-chai": "^3.2.12",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "chai": "^4.4.1",
    "cheerio": "1.1.2",
    "esbuild": "^0.25.12",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "sinon": "^22.1.0",
    "sinon-chai": "^3.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
